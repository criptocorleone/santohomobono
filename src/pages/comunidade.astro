---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Início', item: '/' },
  { name: 'Comunidade', item: '/comunidade' },
];
---

<BaseLayout
  title="Comunidade Santo Homobono: Empresários Católicos"
  description="Uma comunidade de empresários católicos que buscam viver a fé nos negócios, sob a intercessão de Santo Homobono. Saiba como participar."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Mensagem de Confirmação Oficial -->
    <div
      id="confirmacao"
      class="hidden my-8 p-6 sm:p-8 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border-2 border-emerald-600 text-emerald-900 dark:text-emerald-100 text-center shadow-xl"
    >
      <div class="text-4xl mb-3">✓</div>
      <h2 class="font-['Cormorant_Garamond'] text-2xl sm:text-3xl font-bold">
        Recebemos seu contato.
      </h2>
      <p class="text-base sm:text-lg mt-2 font-['Source_Serif_4'] text-emerald-800 dark:text-emerald-200">
        Em breve entraremos em contato pelo WhatsApp para conversar.
      </p>
    </div>

    <header class="text-center my-8 sm:my-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--ouro)]/15 text-[var(--cardinal)] text-xs font-['Cinzel'] font-bold tracking-widest uppercase mb-4 border border-[var(--ouro)]/40">
        <span>⚜</span> Comunidade Santo Homobono <span>⚜</span>
      </div>

      <h1 class="font-['Cormorant_Garamond'] text-3xl sm:text-5xl lg:text-6xl font-bold text-[var(--cardinal)] leading-tight">
        Comunidade Santo Homobono: empresários católicos
      </h1>
      <p class="text-lg sm:text-xl text-[var(--pedra)] font-['Source_Serif_4'] mt-4 max-w-2xl mx-auto leading-relaxed">
        Uma irmandade de empreendedores, líderes de empresas e comerciantes católicos dedicada à oração mútua, à integridade nas práticas de mercado e ao auxílio concreto aos necessitados.
      </p>
    </header>

    <!-- SEÇÕES ESTRUTURADAS CONFORME DIRETRIZ -->
    <div class="space-y-12 my-12">
      <!-- 1. Para quem é -->
      <section class="p-6 sm:p-8 rounded-2xl bg-[var(--pergaminho-escuro)]/60 border border-[var(--ouro-claro)]">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl">🎯</span>
          <h2 class="font-['Cormorant_Garamond'] text-2xl sm:text-3xl font-bold text-[var(--cardinal)]">
            Para quem é a Comunidade
          </h2>
        </div>
        <ul class="space-y-3 text-base text-[var(--tinta)] font-['Source_Serif_4'] leading-relaxed list-disc list-inside">
          <li><strong>Empresários, fundadores e sócios:</strong> que enfrentam diariamente decisões difíceis de gestão e querem viver sua fé católica com fidelidade e sem concessões no mercado.</li>
          <li><strong>Comerciantes e lojistas:</strong> que buscam praticar o justo preço, o acolhimento fraterno e a retidão com clientes, equipes e fornecedores.</li>
          <li><strong>Líderes cristãos nos negócios:</strong> que reconhecem sua profissão como vocação para o bem comum e recusam atalhos de desonestidade ou corrupção.</li>
        </ul>
      </section>

      <!-- 2. Como funciona a entrada -->
      <section class="p-6 sm:p-8 rounded-2xl bg-[var(--pergaminho-escuro)]/60 border border-[var(--ouro-claro)]">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl">📋</span>
          <h2 class="font-['Cormorant_Garamond'] text-2xl sm:text-3xl font-bold text-[var(--cardinal)]">
            Como funciona a entrada
          </h2>
        </div>
        <p class="text-base text-[var(--tinta)] font-['Source_Serif_4'] leading-relaxed mb-6">
          Para mantermos o grupo focado, seguro e fiel ao propósito de oração e formação, a entrada é realizada em três passos simples:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
          <div class="p-4 rounded-xl bg-white/60 dark:bg-black/20 border border-[var(--ouro-claro)]/40">
            <span class="font-['Cinzel'] font-bold text-lg text-[var(--cardinal)] block mb-1">1. Formulário</span>
            <span class="text-xs text-[var(--pedra)]">Você preenche as informações básicas abaixo para nos conhecermos.</span>
          </div>
          <div class="p-4 rounded-xl bg-white/60 dark:bg-black/20 border border-[var(--ouro-claro)]/40">
            <span class="font-['Cinzel'] font-bold text-lg text-[var(--cardinal)] block mb-1">2. Conversa</span>
            <span class="text-xs text-[var(--pedra)]">Nossa equipe entra em contato pelo WhatsApp para um breve alinhamento fraterno.</span>
          </div>
          <div class="p-4 rounded-xl bg-white/60 dark:bg-black/20 border border-[var(--ouro-claro)]/40">
            <span class="font-['Cinzel'] font-bold text-lg text-[var(--cardinal)] block mb-1">3. Convite</span>
            <span class="text-xs text-[var(--pedra)]">Você recebe o convite de acesso para os encontros e para a comunidade.</span>
          </div>
        </div>
      </section>
    </div>

    <!-- FORMULÁRIO DE ENTRADA -->
    <section class="my-14 rounded-2xl bg-[var(--cardinal)] text-white p-6 sm:p-12 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-[var(--ouro)]/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-black/25 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-[var(--ouro-claro)] text-xs font-['Cinzel'] tracking-widest uppercase font-semibold mb-3 border border-white/20">
            Inscrição para a Comunidade
          </span>
          <h2 class="font-['Cormorant_Garamond'] text-3xl sm:text-4xl font-bold leading-tight mb-2 text-white">
            Preencha para solicitar sua participação
          </h2>
          <p class="text-sm sm:text-base text-stone-200 font-['Source_Serif_4']">
            Entraremos em contato com você pelo WhatsApp para a conversa de alinhamento.
          </p>
        </div>

        <form
          id="form-comunidade"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="bg-[var(--pergaminho)] text-[var(--tinta)] rounded-2xl p-6 sm:p-8 shadow-2xl border-2 border-[var(--ouro)]"
        >
          <!-- Web3Forms Config -->
          <input type="hidden" name="access_key" value="0948a901-0933-4402-a19b-4762a7c1c55d" />
          <input type="hidden" name="subject" value="Novo Contato - Comunidade Santo Homobono" />
          <input type="hidden" name="from_name" value="Portal Santo Homobono" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
          <input type="hidden" name="redirect" value="https://santohomobono.com.br/comunidade#confirmacao" />

          <div class="space-y-4">
            <!-- 1. Nome -->
            <div>
              <label for="nome" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
                Seu Nome Completo *
              </label>
              <input
                type="text"
                id="nome"
                name="nome"
                required
                placeholder="Ex: João da Silva"
                class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
              />
            </div>

            <!-- 2. WhatsApp -->
            <div>
              <label for="whatsapp" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
                WhatsApp (com DDD) *
              </label>
              <input
                type="tel"
                id="whatsapp"
                name="whatsapp"
                required
                placeholder="Ex: (11) 99999-9999"
                class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- 3. Empresa e Ramo -->
              <div>
                <label for="empresa" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
                  Empresa e Ramo de Atuação *
                </label>
                <input
                  type="text"
                  id="empresa"
                  name="empresa"
                  required
                  placeholder="Ex: Comércio de Calçados"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
                />
              </div>

              <!-- 4. Cidade -->
              <div>
                <label for="cidade" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
                  Cidade e Estado *
                </label>
                <input
                  type="text"
                  id="cidade"
                  name="cidade"
                  required
                  placeholder="Ex: São Paulo - SP"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
                />
              </div>
            </div>

            <!-- 5. Opcional: Por que você quer participar? -->
            <div>
              <label for="motivo" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
                Por que você quer participar? <span class="text-stone-400 font-normal lowercase">(opcional)</span>
              </label>
              <textarea
                id="motivo"
                name="motivo"
                rows="3"
                placeholder="Conte brevemente sua intenção ou o que busca na comunidade..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400 resize-y"
              ></textarea>
            </div>

            <!-- Botão Quero participar -->
            <div class="pt-2">
              <button
                type="submit"
                id="btn-submit-comunidade"
                class="w-full py-4 px-6 rounded-xl bg-[var(--cardinal)] hover:bg-[#681322] text-white font-['Cinzel'] font-bold text-sm tracking-wider uppercase transition-all shadow-lg hover:shadow-xl hover:scale-[1.01] cursor-pointer"
              >
                Quero participar →
              </button>
            </div>

            <p class="text-center text-xs text-[var(--pedra)] pt-2 font-['Source_Serif_4']">
              🔒 Respeitamos seus dados. Nenhum spam.
            </p>
          </div>
        </form>
      </div>
    </section>
  </div>

  <script is:inline>
    // Checagem de redirecionamento ou envio com sucesso
    if (window.location.hash === '#confirmacao' || window.location.search.includes('nome=')) {
      const confirmBox = document.getElementById('confirmacao');
      if (confirmBox) {
        confirmBox.classList.remove('hidden');
        confirmBox.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Tracking GA4: form_submit como evento chave
    const form = document.getElementById('form-comunidade');
    if (form) {
      form.addEventListener('submit', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'form_submit', {
            form_name: 'comunidade_cadastro',
            form_destination: 'web3forms',
            pagina_origem: window.location.pathname,
          });
        }
      });
    }
  </script>
</BaseLayout>
