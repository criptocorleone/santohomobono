---
import OracaoLayout from '../../layouts/OracaoLayout.astro';

const breadcrumbs = [
  { name: 'Início', item: '/' },
  { name: 'Orações', item: '/oracoes' },
  { name: 'Ladainha de Santo Homobono', item: '/oracoes/ladainha' },
];

const invocacoes = [
  'Santo Homobono, homem bom de nome e de fato',
  'Santo Homobono, espelho de honestidade nos negócios',
  'Santo Homobono, modelo de fidelidade conjugal',
  'Santo Homobono, justo na fixação dos preços',
  'Santo Homobono, patrono e amigo dos trabalhadores',
  'Santo Homobono, consolo dos famintos e desabrigados',
  'Santo Homobono, bolsa inesgotável de caridade',
  'Santo Homobono, pacificador nas contendas civis',
  'Santo Homobono, zeloso pela santidade do lar',
  'Santo Homobono, fervoroso na Santa Missa',
  'Santo Homobono, adorador aos pés da Cruz',
  'Santo Homobono, primeiro leigo comum elevado aos altares',
  'Santo Homobono, glória e protetor da cidade de Cremona',
  'Santo Homobono, intercessor nas dificuldades financeiras',
  'Santo Homobono, patrono perene dos empresários e comerciantes',
];

const linksRelacionados = [
  {
    titulo: 'Oração Tradicional a Santo Homobono',
    href: '/oracoes/oracao-a-santo-homobono',
    categoria: 'Devoção',
    descricao: 'A prece clássica para bênção no comércio e nos contratos.',
  },
  {
    titulo: 'Novena de Santo Homobono (9 Dias)',
    href: '/oracoes/novena-de-santo-homobono',
    categoria: 'Novena',
    descricao: 'Nove dias de súplicas para alcançar graças urgentes.',
  },
  {
    titulo: 'Festa de 13 de Novembro',
    href: '/festa-13-de-novembro',
    categoria: 'Liturgia',
    descricao: 'Como celebrar a memória litúrgica anual do padroeiro.',
  },
];
---

<OracaoLayout
  title="Ladainha Oficial de Santo Homobono de Cremona"
  description="Texto tradicional da Ladainha de Santo Homobono para recitação comunitária ou pessoal em intenção dos empresários, trabalhadores e comerciantes."
  subtitulo="Invocação piedosa aprovada pela autoridade eclesiástica para o culto público e privado ao santo padroeiro."
  tipo="ladainha"
  breadcrumbs={breadcrumbs}
  linksRelacionados={linksRelacionados}
>
  <div class="space-y-4 max-w-2xl mx-auto text-left">
    <div class="text-center italic text-sm text-[var(--pedra)] mb-6">
      Senhor, tende piedade de nós.<br />
      Cristo, tende piedade de nós.<br />
      Senhor, tende piedade de nós.<br />
      Cristo, ouvi-nos. / Cristo, atendei-nos.
    </div>

    <div class="space-y-2.5 border-y border-[var(--ouro-claro)]/40 py-6">
      {invocacoes.map((invocacao) => (
        <div class="flex items-baseline justify-between gap-4 text-base sm:text-lg">
          <span class="text-[var(--tinta)] font-['Source_Serif_4']">{invocacao},</span>
          <span class="font-['Cinzel'] text-xs uppercase tracking-wider text-[var(--cardinal)] font-bold shrink-0">
            rogai por nós.
          </span>
        </div>
      ))}
    </div>

    <div class="pt-6 text-center text-sm text-[var(--pedra)] leading-relaxed font-['Source_Serif_4']">
      <p class="font-bold text-[var(--cardinal)] mb-2 font-['Cormorant_Garamond'] text-xl">
        Oremos:
      </p>
      <p>
        Ó Deus, que no bendito Santo Homobono nos destes um admirável exemplo de como conciliar as ocupações do comércio com a busca apaixonada pelo Vosso Reino, concedei-nos que, imitando a sua fidelidade e socorridos por suas preces, sejamos sempre honestos no trabalho e pródigos na caridade. Por Cristo, nosso Senhor. Amém.
      </p>
    </div>
  </div>
</OracaoLayout>
