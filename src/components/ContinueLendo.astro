---
import CTAComunidade from './CTAComunidade.astro';

export interface LinkInterno {
  titulo: string;
  href: string;
  categoria?: string;
  descricao?: string;
}

export interface Props {
  links?: LinkInterno[];
  mostrarCTA?: boolean;
}

const linksPadrao: LinkInterno[] = [
  {
    titulo: 'Quem foi Santo Homobono? A Biografia Completa',
    href: '/quem-foi-santo-homobono',
    categoria: 'História & Vida',
    descricao: 'Conheça em detalhes a trajetória do mercador de Cremona canonizado em tempo recorde.',
  },
  {
    titulo: 'A Oração do Empresário e do Comerciante',
    href: '/oracoes/oracao-do-empresario',
    categoria: 'Devoção',
    descricao: 'Reze pedindo honestidade, prosperidade com propósito e proteção em suas negociações.',
  },
  {
    titulo: 'Ética nos Negócios: O Justo Preço e a Santidade no Trabalho',
    href: '/padroeiro-dos-empresarios',
    categoria: 'Reflexão & Negócios',
    descricao: 'Como aplicar os princípios cristãos de Santo Homobono no mercado contemporâneo.',
  },
];

const {
  links = linksPadrao,
  mostrarCTA = true,
} = Astro.props;
---

<aside class="my-12 border-t-2 border-[var(--ouro-claro)]/50 pt-10" aria-label="Conteúdos relacionados">
  <div class="mb-6">
    <span class="text-xs uppercase tracking-widest font-['Cinzel'] text-[var(--ouro)] font-bold">
      Aprofunde seus conhecimentos
    </span>
    <h3 class="font-['Cormorant_Garamond'] text-2xl sm:text-3xl font-bold text-[var(--cardinal)] mt-1">
      Continue Lendo
    </h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {links.slice(0, 3).map((link) => (
      <a
        href={link.href}
        class="group flex flex-col justify-between p-5 rounded-xl bg-[var(--pergaminho-escuro)]/50 hover:bg-[var(--pergaminho-escuro)] border border-[var(--ouro-claro)]/60 hover:border-[var(--ouro)] transition-all shadow-sm hover:shadow"
      >
        <div>
          {link.categoria && (
            <span class="text-[0.7rem] uppercase tracking-wider font-['Cinzel'] text-[var(--ouro)] font-semibold block mb-2">
              {link.categoria}
            </span>
          )}
          <h4 class="font-['Cormorant_Garamond'] text-lg sm:text-xl font-bold text-[var(--cardinal)] group-hover:text-[var(--ouro)] transition-colors leading-snug">
            {link.titulo}
          </h4>
          {link.descricao && (
            <p class="text-xs sm:text-sm text-[var(--pedra)] mt-2 font-['Source_Serif_4'] leading-relaxed">
              {link.descricao}
            </p>
          )}
        </div>
        <div class="mt-4 pt-3 border-t border-[var(--ouro-claro)]/30 flex items-center justify-between text-xs text-[var(--cardinal)] font-['Cinzel'] font-bold">
          <span>Ler artigo</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}
  </div>

  {mostrarCTA && (
    <div class="mt-8">
      <CTAComunidade variante="compacta" />
    </div>
  )}
</aside>
