---
export interface Props {
  variante?: 'completa' | 'compacta';
}

const { variante = 'completa' } = Astro.props;
---

<section class="my-14 rounded-2xl bg-[var(--cardinal)] text-white p-6 sm:p-12 shadow-2xl relative overflow-hidden">
  <!-- Efeito de fundo decorativo com pergaminho e ouro -->
  <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-[var(--ouro)]/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-black/25 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-4xl mx-auto">
    <div class="text-center mb-8">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-[var(--ouro-claro)] text-[0.7rem] sm:text-xs font-['Cinzel'] tracking-widest uppercase font-semibold mb-4 border border-white/20">
        Comunidade Santo Homobono
      </span>
      <h2 class="font-['Cormorant_Garamond'] text-3xl sm:text-5xl font-bold leading-tight mb-4 text-white">
        Una-se a Empresários e Comerciantes que Buscam a Santidade no Trabalho
      </h2>
      <p class="text-base sm:text-lg text-stone-200 font-['Source_Serif_4'] max-w-2xl mx-auto leading-relaxed">
        Uma irmandade de empreendedores católicos dedicada à oração mútua, à integridade nas práticas de mercado e ao auxílio concreto aos necessitados.
      </p>
    </div>

    <!-- Formulário Padrão da Comunidade -->
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="bg-[var(--pergaminho)] text-[var(--tinta)] rounded-2xl p-6 sm:p-8 shadow-2xl border-2 border-[var(--ouro)] max-w-2xl mx-auto form-comunidade-padrao"
    >
      <!-- Parâmetros Web3Forms -->
      <input type="hidden" name="access_key" value="0948a901-0933-4402-a19b-4762a7c1c55d" />
      <input type="hidden" name="subject" value="Novo Contato - Comunidade Santo Homobono" />
      <input type="hidden" name="from_name" value="Portal Santo Homobono" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      <input type="hidden" name="redirect" value="https://santohomobono.com.br/comunidade#confirmacao" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="nome" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
            Seu Nome Completo
          </label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            placeholder="Ex: João da Silva"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="Ex: joao@exemplo.com"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
          />
        </div>

        <div>
          <label for="empresa" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
            Empresa / Ramo de Atuação
          </label>
          <input
            type="text"
            id="empresa"
            name="empresa"
            placeholder="Ex: Comércio de Calçados"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
          />
        </div>

        <div>
          <label for="cidade" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
            Cidade e Estado
          </label>
          <input
            type="text"
            id="cidade"
            name="cidade"
            placeholder="Ex: São Paulo - SP"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="mensagem" class="block text-xs font-bold uppercase tracking-wider font-['Cinzel'] text-[var(--pedra)] mb-1.5">
            Mensagem
          </label>
          <textarea
            id="mensagem"
            name="mensagem"
            rows="3"
            placeholder="Sua mensagem ou intenção..."
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--ouro-claro)] bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--cardinal)] placeholder:text-stone-400 resize-none"
          ></textarea>
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3.5 px-6 rounded-lg bg-[var(--cardinal)] hover:bg-[#60161b] text-white font-['Cinzel'] font-bold text-sm uppercase tracking-wider transition-colors shadow-md flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Quero Participar</span>
      </button>

      <p class="text-[0.75rem] text-center text-[var(--pedra)] mt-3">
        🔒 Respeitamos seus dados. Nenhum spam.
      </p>

      <!-- Feedback de status inline -->
      <div class="status-msg hidden mt-3 p-3 rounded-lg text-center text-xs font-semibold"></div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('.form-comunidade-padrao').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const statusMsg = form.querySelector('.status-msg') as HTMLElement | null;
      const originalHtml = btn?.innerHTML;

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>Enviando inscrição...</span>';
      }

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
          },
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          if (statusMsg) {
            statusMsg.className = 'status-msg mt-3 p-3 rounded-lg text-center text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300 block';
            statusMsg.textContent = '✓ Inscrição enviada com sucesso! Recebemos sua mensagem e entraremos em contato.';
          }
          form.reset();
        } else {
          // Fallback tradicional caso a API retorne erro ou exija redirecionamento
          form.submit();
        }
      } catch (err) {
        // Fallback para envio nativo se falhar o fetch
        form.submit();
      } finally {
        if (btn) {
          btn.disabled = false;
          if (originalHtml) btn.innerHTML = originalHtml;
        }
      }
    });
  });
</script>
