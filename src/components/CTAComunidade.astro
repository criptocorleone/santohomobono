---
export interface Props {
  variante?: 'completa' | 'compacta';
  paginaOrigem?: string;
}

const { variante = 'completa', paginaOrigem = Astro.url.pathname } = Astro.props;
---

<section class={`my-14 rounded-2xl bg-[var(--cardinal)] text-white p-6 ${variante === 'compacta' ? 'sm:p-8' : 'sm:p-10'} shadow-2xl relative overflow-hidden border-2 border-[var(--ouro)]/40`}>
  <!-- Efeitos de fundo sacros -->
  <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-[var(--ouro)]/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-black/30 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center space-y-5">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-[var(--ouro-claro)] text-xs font-['Cinzel'] tracking-widest uppercase font-semibold border border-white/20">
      <span>⚜</span>
      <span>Comunidade Santo Homobono</span>
      <span>⚜</span>
    </div>

    <h2 class="font-['Cormorant_Garamond'] text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-white">
      Você é empresário católico?
    </h2>

    <p class="text-base sm:text-lg text-stone-200 font-['Source_Serif_4'] leading-relaxed">
      Estamos formando a <strong>Comunidade Santo Homobono</strong>, um grupo de empresários que querem viver a fé nos negócios: rezar juntos, se formar na Doutrina Social da Igreja e se apoiar mutuamente.
    </p>

    <p class="text-sm sm:text-base text-stone-300 font-['Source_Serif_4'] italic">
      A entrada é feita após uma breve conversa conosco, para mantermos o grupo como ele deve ser.
    </p>

    <div class="pt-2">
      <a
        href="/comunidade"
        class="btn-cta-comunidade inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[var(--ouro)] hover:bg-[#d4af37] text-[var(--cardinal)] font-['Cinzel'] font-bold text-sm tracking-wider uppercase transition-all shadow-lg hover:shadow-xl hover:scale-[1.02]"
        data-pagina-origem={paginaOrigem}
      >
        <span>Quero conhecer a comunidade</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.btn-cta-comunidade').forEach((btn) => {
      btn.addEventListener('click', function () {
        const pagina = this.getAttribute('data-pagina-origem') || window.location.pathname;
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'cta_comunidade_click', {
            pagina_origem: pagina,
          });
        }
      });
    });
  });
</script>
