---
export interface Props {
  titulo: string;
  subtitulo?: string;
  descricao?: string;
  class?: string;
}

const {
  titulo,
  subtitulo = 'Acervo Documental Histórico',
  descricao,
  class: className = '',
} = Astro.props;
---

<figure class:list={["my-6 p-6 rounded-2xl bg-[var(--pergaminho-escuro)]/50 border-2 border-dashed border-[var(--ouro)]/70 text-center flex flex-col items-center justify-center moldura-sacra transition-colors", className]}>
  <!-- Ícone SVG da Bolsa de Esmolas -->
  <div class="w-16 h-16 rounded-full bg-[var(--pergaminho)] border border-[var(--ouro)] flex items-center justify-center p-3 mb-3 shadow-inner">
    <svg class="w-full h-full text-[var(--ouro)]" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M22 16C22 13.7909 23.7909 12 26 12H38C40.2091 12 42 13.7909 42 16V20H22V16Z" fill="var(--ouro)" />
      <path d="M14 24C14 21.7909 15.7909 20 18 20H46C48.2091 20 50 21.7909 50 24L53 50C53 55.5228 48.5228 60 43 60H21C15.4772 60 11 55.5228 11 50L14 24Z" fill="var(--cardinal)" stroke="var(--ouro)" stroke-width="2" />
      <path d="M20 22C20 22 24 28 32 28C40 28 44 22 44 22" stroke="var(--ouro-claro)" stroke-width="3" stroke-linecap="round" />
      <path d="M32 34V46M26 38H38" stroke="var(--ouro-claro)" stroke-width="2.5" stroke-linecap="round" />
    </svg>
  </div>

  <span class="inline-block px-3 py-1 rounded-full bg-[var(--ouro)]/15 text-[var(--ouro)] text-[0.7rem] font-['Cinzel'] font-bold tracking-widest uppercase mb-1 border border-[var(--ouro)]/30">
    Imagem em breve
  </span>

  <h4 class="font-['Cormorant_Garamond'] text-xl sm:text-2xl font-bold text-[var(--cardinal)] mt-1">
    {titulo}
  </h4>

  <p class="text-xs font-['Cinzel'] text-[var(--pedra)] uppercase tracking-wider mt-0.5">
    {subtitulo}
  </p>

  {descricao && (
    <p class="text-xs sm:text-sm text-[var(--pedra)] font-['Source_Serif_4'] max-w-md mt-2 italic leading-relaxed">
      {descricao}
    </p>
  )}
</figure>
