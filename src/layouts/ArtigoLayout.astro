---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import ContinueLendo, { type LinkInterno } from '../components/ContinueLendo.astro';
import SeloFonte from '../components/SeloFonte.astro';
import type { FAQItem } from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  publishDate?: Date | string;
  updatedDate?: Date | string;
  image?: string;
  imageAlt?: string;
  sources?: string[];
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FAQItem[];
  tipoFonte?: 'historico' | 'tradicao' | 'documental';
  linksRelacionados?: LinkInterno[];
  subtitulo?: string;
}

const {
  title,
  description,
  publishDate = new Date('2026-10-09'),
  updatedDate,
  image = '/og-default.jpg',
  imageAlt = title,
  sources = ['Bula Quia pietas (1199)', 'André Vauchez, La sainteté en Occident', 'Dizionario Biografico degli Italiani (Treccani)'],
  breadcrumbs = [
    { name: 'História & Artigos', item: '/historia/linha-do-tempo' },
    { name: title, item: Astro.url.pathname },
  ],
  faqs = [],
  tipoFonte = 'historico',
  linksRelacionados,
  subtitulo,
} = Astro.props;

const dataPublicacaoFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(publishDate));

const dataRevisaoFormatada = updatedDate
  ? new Intl.DateTimeFormat('pt-BR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(updatedDate))
  : null;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs de Navegação -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Cabeçalho do Artigo -->
    <header class="my-6 border-b border-[var(--ouro-claro)]/40 pb-8">
      <div class="mb-3">
        <SeloFonte tipo={tipoFonte} />
      </div>

      <h1 class="font-['Cormorant_Garamond'] text-3xl sm:text-5xl lg:text-6xl font-bold text-[var(--cardinal)] leading-tight tracking-tight">
        {title}
      </h1>

      {subtitulo && (
        <p class="text-lg sm:text-xl text-[var(--pedra)] font-['Source_Serif_4'] mt-3 italic leading-relaxed">
          {subtitulo}
        </p>
      )}

      <!-- Metadados de Autoridade (E-E-A-T) -->
      <div class="mt-6 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-[var(--pedra)] font-['Cinzel'] tracking-wider border-t border-[var(--ouro-claro)]/30 pt-4">
        <span class="flex items-center gap-1.5">
          <span>✍</span> Redação Santo Homobono
        </span>
        <span>·</span>
        <span class="flex items-center gap-1.5">
          <time datetime={new Date(publishDate).toISOString()}>{dataPublicacaoFormatada}</time>
        </span>
        {dataRevisaoFormatada && (
          <>
            <span>·</span>
            <span class="text-[var(--ouro)] font-semibold">
              Revisado em {dataRevisaoFormatada}
            </span>
          </>
        )}
      </div>
    </header>

    <!-- Conteúdo do Artigo com Capitular e Tipografia Editorial -->
    <div class="prose prose-lg dark:prose-invert max-w-none font-['Source_Serif_4'] text-[var(--tinta)] leading-relaxed space-y-6 [&>p:first-of-type]:capitular">
      <slot />
    </div>

    <!-- Fontes & Referências Documentais (E-E-A-T) -->
    {sources && sources.length > 0 && (
      <section class="mt-12 p-6 rounded-xl bg-[var(--pergaminho-escuro)]/60 border border-[var(--ouro-claro)]/70 text-xs sm:text-sm text-[var(--pedra)]" aria-label="Fontes bibliográficas">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[var(--ouro)] font-bold text-base">📜</span>
          <h2 class="font-['Cinzel'] text-xs font-bold uppercase tracking-wider text-[var(--cardinal)]">
            Fontes & Documentação Histórica
          </h2>
        </div>
        <ul class="list-disc list-inside space-y-1.5">
          {sources.map((source) => (
            <li class="leading-relaxed">{source}</li>
          ))}
        </ul>
        <p class="mt-3 text-[0.7rem] text-[var(--pedra)] border-t border-[var(--ouro-claro)]/30 pt-2">
          Consulte nossa seção de <a href="/fontes-e-documentos" class="text-[var(--cardinal)] hover:underline font-semibold">Fontes e Documentos</a> para o dossiê bibliográfico completo.
        </p>
      </section>
    )}

    <!-- Bloco de Continuidade Obrigatório (Regra UX: 3 links + CTA) -->
    <ContinueLendo links={linksRelacionados} />
  </article>
</BaseLayout>
